<%- include('partials/header') %>

<h1>Task Manager</h1>

<div class="nav-links">
    <a href="/completed">View Completed</a>
    <a href="/unfinished">View Unfinished</a>
    <a href="/all-tasks">View All Tasks</a>
</div>

<div id="errorMessage" style="color: blue"></div>

<form action="/add-task" method="post" class="task-form">
    <input type="text" name="name" id="addName" placeholder="Task Name" required>
    <input type="text" name="description" id="addDesc" placeholder="Task Description" required>
    <select name="priority" required>
        <option value="High">Highest Priority</option>
        <option value="Medium" selected>Medium Priority</option>
        <option value="Low">Lowest Priority</option>
    </select>
    <button type="submit">Add Task</button>
</form>

<ul>
    <% tasks.forEach(task => { %>
        <li class="<%= task.completed ? 'completed' : '' %>">
            <%= task.name %> - <%= task.description %>
            <span style="font-weight: bold">
                [
                <% if (task.priority === 'High') { %>
                    Highest Priority
                <% } else if (task.priority === 'Medium') { %>
                    Medium Priority
                <% } else if (task.priority === 'Low') { %>
                    Lowest Priority
                <% } %>
                ]
            </span>
            <div class="task-actions">
                <form action="/toggle-task/<%= task.id %>" method="post">
                    <button type="submit"><%= task.completed ? 'Undo' : 'Complete' %></button>
                </form>
                <form action="/delete-task/<%= task.id %>" method="post">
                    <button type="submit">Delete</button>
                </form>
                <button onclick="showUpdateForm('<%= task.id %>', '<%= task.name %>', '<%= task.description %>', '<%= task.priority %>')">Update</button>
            </div>
        </li>
    <% }); %>
</ul>

<div id="updateFormContainer" style="display: none;">
    <h2>Update Task</h2>
    <form id="updateForm" method="post">
        <input type="hidden" name="id" id="updateTaskId">
        <input type="text" name="name" id="updateTaskName" required>
        <input type="text" name="description" id="updateTaskDesc" required>
        <select name="priority" id="updateTaskPriority" required>
            <option value="High">Highest Priority</option>
            <option value="Medium">Medium Priority</option>
            <option value="Low">Lowest Priority</option>
        </select>
        <button type="submit">Update</button>
        <button type="button" onclick="hideUpdateForm()">Cancel</button>
    </form>
</div>

<script>
    const params = new URLSearchParams(window.location.search);

    if (params.get('error')) {
        document.getElementById("errorMessage").innerText = decodeURIComponent(params.get('error'));
    }
    if (params.get('name')) {
        document.getElementById("addName").value = decodeURIComponent(params.get('name'));
    }
    if (params.get('description')) {
        document.getElementById("addDesc").value = decodeURIComponent(params.get('description'));
    }

    if (params.get('updateError')) {
        document.getElementById("updateErrorMessage").innerText = decodeURIComponent(params.get('updateError'));
        document.getElementById("updateFormContainer").style.display = "block";
    }
    if (params.get('updateName')) {
        document.getElementById("updateTaskName").value = decodeURIComponent(params.get('updateName'));
    }
    if (params.get('updateDesc')) {
        document.getElementById("updateTaskDesc").value = decodeURIComponent(params.get('updateDesc'));
    }
    if (params.get('id')) {
        document.getElementById("updateTaskId").value = params.get('id');
        document.getElementById("updateForm").action = "/update-task/" + params.get('id');
        document.getElementById("updateFormContainer").style.display = "block";
    }

    function showUpdateForm(id, name, description, priority) {
        document.getElementById("updateForm").action = "/update-task/" + id;
        document.getElementById("updateTaskId").value = id;
        document.getElementById("updateTaskName").value = name;
        document.getElementById("updateTaskDesc").value = description;
        document.getElementById("updateTaskPriority").value = priority;
        document.getElementById("updateFormContainer").style.display = "block";
    }

    function hideUpdateForm() {
        document.getElementById("updateFormContainer").style.display = "none";
    }

    if (history.replaceState) {
        history.replaceState(null, '', window.location.pathname);
    }
</script>

<%- include('partials/footer') %>
